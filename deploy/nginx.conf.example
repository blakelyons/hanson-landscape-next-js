# Example Nginx reverse proxy for the Next.js server (PM2-managed, port 3000)
# running on this DigitalOcean droplet. Copy to
# /etc/nginx/sites-available/hansonlandscape.com and symlink into
# sites-enabled, then `sudo nginx -t && sudo systemctl reload nginx`.
# Use certbot (Let's Encrypt) to add the TLS server block.

server {
    listen 80;
    server_name hansonlandscape.com www.hansonlandscape.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
