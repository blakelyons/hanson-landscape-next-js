# Contact form email (Resend — https://resend.com). Server-only: never prefix with NEXT_PUBLIC_.
# Without RESEND_API_KEY, `next dev` just logs the email to the console.
RESEND_API_KEY=
# Where inquiries go. One address, or several separated by commas.
CONTACT_TO_EMAIL=blake@blakelyons.com
# Must be a verified domain in Resend for production. For testing, onboarding@resend.dev
# only delivers to the email your Resend account was created with.
CONTACT_FROM_EMAIL="Hanson Landscape Website <onboarding@resend.dev>"

# Public site URL — used for metadata, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://hansonlandscape.com

# Google Analytics 4 measurement ID. Build-time: must be set before `next build`.
NEXT_PUBLIC_GA_ID=

# Careers application form (own inbox). From address falls back to CONTACT_FROM_EMAIL.
CAREERS_TO_EMAIL=blake@blakelyons.com
# CAREERS_FROM_EMAIL=

# Cloudflare Turnstile (bot check on both forms). Site key is public and build-time
# (needs a rebuild to change); the secret is server-only. Without the secret, verification
# is skipped. Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
