# Contact form email (Resend — https://resend.com). Server-only: never prefix with NEXT_PUBLIC_.
# Without RESEND_API_KEY, `next dev` just logs the email to the console.
RESEND_API_KEY=
# Where inquiries go. Testing: blake@blakelyons.com. Swap for Hanson's inbox at launch.
CONTACT_TO_EMAIL=blake@blakelyons.com
# Must be a verified domain in Resend for production. For testing, onboarding@resend.dev
# only delivers to the email your Resend account was created with.
CONTACT_FROM_EMAIL="Hanson Landscape Website <onboarding@resend.dev>"

# Public site URL — used for metadata, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://hansonlandscape.com
